generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HR
  EVALUATOR
  OWNER
}

enum AssessmentStatus {
  draft
  completed
  approved
}

enum LeaveStatus {
  pending
  approved
  rejected
  cancelled
}

enum RedemptionStatus {
  pending
  approved
  rejected
  delivered
  cancelled
}

enum RewardType {
  cash
  product
  voucher
}

enum OvertimeType {
  flat
  hourly
  hybrid
}

model User {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  emailVerified DateTime?
  password      String
  role          Role      @default(EVALUATOR)
  isActive      Boolean   @default(true)
  rememberToken String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assessments         Assessment[]        @relation("Evaluator")
  auditLogs           AuditLog[]
  notifications       Notification[]
  leaveDecisions      LeaveRequest[]      @relation("LeaveDecider")
  redemptionDecisions PointRedemption[]   @relation("RedemptionDecider")
  lemburDecisions     PengajuanLembur[]   @relation("LemburDecider")
  reimburseDecisions  Reimbursement[]     @relation("ReimburseDecider")
  absenHpDecisions    AbsenHpBukti[]      @relation("AbsenHpDecider")
  absenTimDecisions   AbsenTimBaris[]     @relation("AbsenTimDecider")
  rekapDecisions      RekapHarian[]       @relation("RekapDecider")
  magangDinilai       MagangTugas[]       @relation("MagangPenilai")
  magangJurnalDicek   MagangJurnal[]      @relation("MagangJurnalCek")
  magangMisiDiputus   MagangMisiKiriman[] @relation("MagangMisiPutus")
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  positions Position[]
  employees Employee[]
}

model Position {
  id           Int      @id @default(autoincrement())
  name         String
  departmentId Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employees  Employee[]

  @@index([departmentId])
}

model WorkSchedule {
  id                   Int       @id @default(autoincrement())
  name                 String
  startTime            String?
  endTime              String?
  breakStartTime       String?
  breakEndTime         String?
  lateToleranceMinutes Int       @default(15)
  dailyWage            Decimal   @default(0) @db.Decimal(15, 2)
  weeklyWage           Decimal   @default(0) @db.Decimal(15, 2)
  monthlyWage          Decimal   @default(0) @db.Decimal(15, 2)
  holidayWage          Decimal   @default(0) @db.Decimal(15, 2)
  overtimeWagePerHour  Decimal   @default(0) @db.Decimal(15, 2)
  isHoliday            Boolean   @default(false)
  // Mode "jam masuk bebas": lembur dari durasi kerja (8 jam) + uang makan (>10 jam), bukan shift jam-dinding.
  flexibleHours        Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  employees   Employee[]
  jadwalShift JadwalShift[]
}

model Employee {
  id                 Int       @id @default(autoincrement())
  employeeCode       String    @unique @db.VarChar(20)
  machinePin         String?   @unique @db.VarChar(50)
  publicToken        String?   @unique @db.VarChar(36)
  fullName           String    @db.VarChar(150)
  nickname           String?   @db.VarChar(50)
  departmentId       Int?
  positionId         Int?
  workScheduleId     Int?
  photoPath          String?   @db.VarChar(255)
  joinDate           DateTime?
  salary             Decimal?  @db.Decimal(15, 2)
  email              String?
  phone              String?
  isActive           Boolean   @default(true)
  // Portal karyawan (/me/[token]): hash bcrypt PIN. Null = PIN belum dibuat.
  portalPin          String?   @db.VarChar(100)
  portalPinSetAt     DateTime?
  // Pemetaan ke akun PosPro (User.id di sana) untuk menarik KPI kinerja.
  // Null = belum dipetakan; KPI PosPro tidak ditampilkan untuk karyawan ini.
  posproUserId       Int?      @unique
  // Absen lewat HP (add-on hr.absen_hp): dinyalakan owner PER KARYAWAN. Perangkat = sidik
  // (sha256) id acak yang disimpan HP pertama yang dipakai — HP lain ditolak sampai owner
  // melepasnya. Yang disimpan cuma sidiknya, jadi isi basis data tidak bisa dipakai menyamar.
  absenHp            Boolean   @default(false)
  absenHpPerangkat   String?   @db.VarChar(64)
  absenHpPerangkatAt DateTime?
  // Absen tim oleh PIC lapangan (18 Okt 2026). jenis "tetap" | "freelance". bisaAbsenTim = PIC
  // yang boleh mengabsenkan anggotanya dari HP-nya sendiri. Freelance yang didaftarkan PIC di
  // tempat membawa didaftarkanOlehId + perluDiperiksa=true sampai owner/HR memeriksanya
  // (mencegah tukang fiktif).
  jenis              String    @default("tetap") @db.VarChar(20)
  bisaAbsenTim       Boolean   @default(false)
  didaftarkanOlehId  Int?
  perluDiperiksa     Boolean   @default(false)
  // Upah tukang (Tahap 1). Null = belum diatur; tarif proyek / kota×divisi didahulukan.
  upahHarian         Decimal?  @db.Decimal(12, 2)
  upahLemburPerJam   Decimal?  @db.Decimal(12, 2)
  kotaBawaan         String?   @db.VarChar(100)
  divisiBawaan       String?   @db.VarChar(100)
  timId              Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  department           Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position             Position?              @relation(fields: [positionId], references: [id], onDelete: SetNull)
  workSchedule         WorkSchedule?          @relation(fields: [workScheduleId], references: [id], onDelete: SetNull)
  assessments          Assessment[]
  attendances          Attendance[]
  enrollments          MachineEnrollment[]
  leaveRequests        LeaveRequest[]
  pointEntries         PointEntry[]
  pointRedemptions     PointRedemption[]
  absenHpBukti         AbsenHpBukti[]
  peminjamanInventaris PeminjamanInventaris[]
  pengajuanLembur      PengajuanLembur[]
  jadwalShift          JadwalShift[]
  reimbursement        Reimbursement[]
  kunjunganKlien       KunjunganKlien[]
  timesheetEntri       TimesheetEntri[]
  didaftarkanOleh      Employee?              @relation("FreelanceDariPic", fields: [didaftarkanOlehId], references: [id], onDelete: SetNull)
  freelanceDidaftarkan Employee[]             @relation("FreelanceDariPic")
  sesiAbsenTim         SesiAbsenTim[]
  absenTimBaris        AbsenTimBaris[]
  tim                  TimKerja?              @relation("TimAnggota", fields: [timId], references: [id], onDelete: SetNull)
  timDipimpin          TimKerja?              @relation("TimPic")
  rekapHarian          RekapHarian[]          @relation("RekapKaryawan")
  rekapDicatat         RekapHarian[]          @relation("RekapPic")
  penyesuaianUpah      PenyesuaianUpah[]      @relation("PenyesuaianKaryawan")
  pembayaranUpah       PembayaranUpah[]       @relation("PembayaranKaryawan")
  magangPeserta        MagangPeserta?
  magangDibimbing      MagangPos[]            @relation("MagangPembimbing")
  magangDinilai        MagangTugas[]          @relation("MagangPenilaiKaryawan")
  magangJurnalDicek    MagangJurnal[]         @relation("MagangJurnalCekKaryawan")
  magangMisiDiputus    MagangMisiKiriman[]    @relation("MagangMisiPutusKaryawan")

  @@index([isActive])
}

// Lokasi tempat karyawan boleh absen lewat HP (toko, gudang, lokasi event). Absen diterima
// kalau HP berada dalam `radiusM` dari titik ini. `wajibQr` = HP juga harus memindai QR yang
// berganti di layar lokasi itu (/absen-layar/<layarToken>); kodenya HMAC(qrRahasia, slot waktu).
model AbsenLokasi {
  id         Int      @id @default(autoincrement())
  nama       String   @db.VarChar(100)
  lat        Float
  lng        Float
  radiusM    Int      @default(100)
  wajibQr    Boolean  @default(false)
  qrRahasia  String   @db.VarChar(64)
  layarToken String   @unique @db.VarChar(36)
  aktif      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  bukti AbsenHpBukti[]
}

// Bukti satu absen lewat HP: foto, posisi, jarak ke lokasi, perangkat, dan apakah QR dipindai.
// Disimpan TERPISAH dari Attendance supaya baris absensi tetap berbentuk sama dengan scan mesin.
model AbsenHpBukti {
  id               Int       @id @default(autoincrement())
  attendanceId     Int?      @unique
  employeeId       Int
  lokasiId         Int?
  lat              Float
  lng              Float
  akurasiM         Int
  jarakM           Int
  fotoPath         String    @db.VarChar(255)
  perangkat        String    @db.VarChar(64)
  qr               Boolean   @default(false)
  ip               String?   @db.VarChar(64)
  // diterima | menunggu | ditolak. "menunggu" = absen di luar radius lokasi yang DIAJUKAN
  // karyawan; attendanceId baru terisi saat owner menyetujuinya.
  status           String    @default("diterima") @db.VarChar(20)
  alasan           String?   @db.Text
  decidedById      Int?
  decidedAt        DateTime?
  catatanKeputusan String?   @db.Text
  createdAt        DateTime  @default(now())

  employee  Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  lokasi    AbsenLokasi? @relation(fields: [lokasiId], references: [id], onDelete: SetNull)
  decidedBy User?        @relation("AbsenHpDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([employeeId, createdAt])
  @@index([status])
}

// Absen tim: satu sesi = satu tempat kerja satu hari, dibuka PIC dari HP-nya. Titiknya GPS HP PIC
// saat membuka sesi — owner tidak perlu membuat "lokasi absen" untuk tiap venue.
model SesiAbsenTim {
  id           Int       @id @default(autoincrement())
  picId        Int
  namaTempat   String    @db.VarChar(150)
  lat          Float
  lng          Float
  akurasiM     Int
  mulaiAt      DateTime  @default(now())
  catatan      String?   @db.Text
  // Notifikasi ke owner/HR terakhir untuk sesi ini — paling banyak satu per 30 menit, supaya
  // 20 tukang yang diabsen tidak menjadi 20 notifikasi.
  diberitahuAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  pic   Employee        @relation(fields: [picId], references: [id], onDelete: Cascade)
  baris AbsenTimBaris[]

  @@index([picId, mulaiAt])
  @@index([mulaiAt])
}

// Satu absen masuk/pulang anggota yang dicatat PIC. MENUNGGU sampai owner/HR menyetujui; baru
// saat disetujui lahir baris Attendance (machineName "tim") — laporan apa pun membaca Attendance,
// jadi yang menunggu/ditolak tidak pernah terhitung.
model AbsenTimBaris {
  id               Int       @id @default(autoincrement())
  sesiId           Int
  employeeId       Int
  jenis            String    @db.VarChar(10) // in | out
  waktu            DateTime  @default(now())
  lat              Float
  lng              Float
  akurasiM         Int
  fotoPath         String    @db.VarChar(255)
  status           String    @default("menunggu") @db.VarChar(20) // menunggu | diterima | ditolak
  attendanceId     Int?      @unique
  decidedById      Int?
  decidedAt        DateTime?
  catatanKeputusan String?   @db.Text
  createdAt        DateTime  @default(now())

  sesi      SesiAbsenTim @relation(fields: [sesiId], references: [id], onDelete: Cascade)
  employee  Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  decidedBy User?        @relation("AbsenTimDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([sesiId, status])
  @@index([employeeId, waktu])
  @@index([status])
}

// Mesin absensi fisik (per cabang). Dikenali dari SN (dev_id) yang dikirim mesin.
model Machine {
  id                  Int       @id @default(autoincrement())
  sn                  String    @unique @db.VarChar(100)
  name                String    @db.VarChar(100)
  mode                String    @default("cloud") @db.VarChar(20) // "cloud" (push) | "lan" (tarik IP)
  ip                  String?   @db.VarChar(64)
  port                Int?
  autoPull            Boolean   @default(false) // mode LAN: tarik otomatis terjadwal
  pullIntervalMinutes Int       @default(15)
  lastSeenAt          DateTime?
  // Alamat (Host) & IP publik yang dipakai mesin pada kontak terakhirnya — untuk "Info Mesin":
  // tahu mesin sudah memakai alamat baru atau masih alamat lama, dan dari toko mana.
  lastHost            String?   @db.VarChar(255)
  lastIp              String?   @db.VarChar(64)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  enrollments MachineEnrollment[]
  attendances Attendance[]
  perintah    FingerspotPerintah[]
}

// Pemetaan PIN mesin → karyawan, per MESIN. PIN unik per mesin (bukan global),
// sehingga dua cabang boleh memakai PIN yang sama untuk orang berbeda.
model MachineEnrollment {
  id         Int      @id @default(autoincrement())
  machineId  Int
  pin        String   @db.VarChar(50)
  employeeId Int
  deviceName String?  @db.VarChar(150)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  machine  Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([machineId, pin])
  @@index([employeeId])
}

model AssessmentTemplate {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(100)
  description    String?  @db.Text
  departmentType String?  @db.VarChar(50)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  indicators  AssessmentIndicator[]
  assessments Assessment[]

  @@index([isActive])
}

model AssessmentIndicator {
  id          Int      @id @default(autoincrement())
  templateId  Int
  category    String   @db.VarChar(100)
  name        String   @db.VarChar(150)
  description String?  @db.Text
  weight      Decimal  @db.Decimal(5, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  template AssessmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  scores   AssessmentScore[]

  @@index([templateId])
}

model Assessment {
  id              Int              @id @default(autoincrement())
  employeeId      Int
  templateId      Int
  evaluatorId     Int?
  isPublic        Boolean          @default(false)
  assessmentDate  DateTime
  period          String?
  totalScore      Decimal?         @db.Decimal(5, 2)
  grade           String?          @db.VarChar(20)
  raterName       String?
  evaluatorNotes  String?          @db.Text
  developmentPlan String?          @db.Text
  recommendation  String?          @db.Text
  status          AssessmentStatus @default(draft)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  employee  Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  template  AssessmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  evaluator User?              @relation("Evaluator", fields: [evaluatorId], references: [id], onDelete: Cascade)
  scores    AssessmentScore[]

  @@index([employeeId])
  @@index([templateId])
  @@index([evaluatorId])
  @@index([assessmentDate])
  @@index([status])
}

model AssessmentScore {
  id            Int      @id @default(autoincrement())
  assessmentId  Int
  indicatorId   Int
  score         Int
  weightedValue Decimal  @db.Decimal(5, 2)
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assessment Assessment          @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  indicator  AssessmentIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([indicatorId])
}

model OvertimeCategory {
  id             Int          @id @default(autoincrement())
  name           String
  type           OvertimeType @default(hourly)
  rate           Decimal      @default(0) @db.Decimal(10, 2)
  companyContext String       @default("default")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  attendances Attendance[]
}

model Attendance {
  id                      Int      @id @default(autoincrement())
  employeeId              Int
  scanDate                DateTime
  scanType                String?  @db.VarChar(20)
  machineName             String?  @db.VarChar(100)
  snMachine               String?  @db.VarChar(100)
  machineId               Int?
  status                  String   @default("on_time") @db.VarChar(20)
  absenceReason           String?  @db.Text
  lateMinutes             Int      @default(0)
  overtimeMinutes         Int      @default(0)
  overtimeReason          String?  @db.Text
  overtimeCategoryId      Int?
  approvedOvertimeMinutes Int      @default(0)
  overtimeAmount          Decimal  @default(0) @db.Decimal(12, 2)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  employee         Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  overtimeCategory OvertimeCategory? @relation(fields: [overtimeCategoryId], references: [id], onDelete: SetNull)
  machine          Machine?          @relation(fields: [machineId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([scanDate])
  @@index([status])
  @@index([machineId])
}

// Pengajuan izin/sakit/cuti. Baru menyentuh Attendance SETELAH disetujui owner/manajemen.
model LeaveRequest {
  id           Int         @id @default(autoincrement())
  employeeId   Int
  startDate    DateTime
  endDate      DateTime
  type         String      @db.VarChar(20) // "Izin" | "Sakit" | "Cuti"
  reason       String      @db.Text
  status       LeaveStatus @default(pending)
  // "portal" (halaman karyawan) | "link" (form publik) | "admin"
  source       String      @default("portal") @db.VarChar(20)
  decidedById  Int?
  decidedAt    DateTime?
  decisionNote String?     @db.Text
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  decidedBy User?    @relation("LeaveDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([status])
  @@index([startDate])
}

// Poin harian karyawan — hasil hitungan dari omzet, pekerjaan, task & kehadiran.
// Disimpan (bukan dihitung ulang tiap buka halaman) supaya saldo poin murah dihitung
// dan riwayatnya tidak berubah walau tarif poin kelak diubah.
model PointEntry {
  id               Int      @id @default(autoincrement())
  employeeId       Int
  date             DateTime
  /**
   * Omzet hari itu (kasir + desain + produksi) — disimpan untuk penjelasan.
   */
  omzet            Decimal  @default(0) @db.Decimal(15, 2)
  omzetPoints      Int      @default(0)
  jobPoints        Int      @default(0)
  taskPoints       Int      @default(0)
  attendancePoints Int      @default(0)
  points           Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([date])
}

// Katalog hadiah yang bisa ditukar dengan poin.
model Reward {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(150)
  description String?    @db.Text
  type        RewardType @default(product)
  pointCost   Int
  /**
   * Nilai rupiah untuk hadiah uang; hanya informasi untuk jenis lain.
   */
  cashValue   Decimal?   @db.Decimal(15, 2)
  /**
   * null = tidak dibatasi.
   */
  stock       Int?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  redemptions PointRedemption[]

  @@index([isActive])
}

// Pengajuan penukaran poin oleh karyawan; poin baru terpotong setelah disetujui.
model PointRedemption {
  id           Int              @id @default(autoincrement())
  employeeId   Int
  rewardId     Int?
  /**
   * Nama & harga poin disalin saat mengajukan agar riwayat tak berubah.
   */
  rewardName   String           @db.VarChar(150)
  pointCost    Int
  status       RedemptionStatus @default(pending)
  note         String?          @db.Text
  decisionNote String?          @db.Text
  decidedById  Int?
  decidedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reward    Reward?  @relation(fields: [rewardId], references: [id], onDelete: SetNull)
  decidedBy User?    @relation("RedemptionDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([status])
}

model Holiday {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeaveLink {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  action      String   @db.VarChar(50)
  targetTable String   @db.VarChar(50)
  targetId    Int?
  oldValues   Json?
  newValues   Json?
  ipAddress   String?  @db.VarChar(45)
  userAgent   String?  @db.Text
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([targetTable])
  @@index([createdAt])
}

model Notification {
  id        String    @id @default(uuid())
  userId    Int
  type      String
  data      Json
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
}

// Pondasi "cloud mesin absensi": raw push log dari mesin Fingerspot
model FingerspotRawLog {
  id        Int       @id @default(autoincrement())
  snMachine String?   @db.VarChar(100)
  pin       String?   @db.VarChar(50)
  scanAt    DateTime?
  rawBody   Json
  processed Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([processed])
  @@index([snMachine])
}

// Tiket masuk `qm1` yang sudah dipakai (lib/lisensi/tiket-masuk.ts): jti sekali pakai, disimpan
// sampai tiketnya kedaluwarsa supaya tautan yang sama tidak bisa dipakai dua kali.
model TiketMasukTerpakai {
  jti             String   @id @db.VarChar(64)
  kedaluwarsaPada DateTime
  createdAt       DateTime @default(now())

  @@index([kedaluwarsaPada])
}

// Inventaris kantor: barang milik usaha yang dipinjamkan ke karyawan (seragam, laptop, kunci,
// kartu ID). `jumlah` = seluruh unit yang dimiliki; `rusakHilang` = unit yang tidak bisa dipakai
// lagi. Unit dipegang dihitung dari peminjaman yang belum kembali, jadi tidak disimpan dua kali.
model InventarisKantor {
  id          Int      @id @default(autoincrement())
  nama        String   @db.VarChar(150)
  // seragam | laptop | kunci | kartu_id | elektronik | lainnya
  kategori    String   @default("lainnya") @db.VarChar(30)
  keterangan  String?  @db.VarChar(500)
  jumlah      Int      @default(1)
  rusakHilang Int      @default(0)
  aktif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  peminjaman PeminjamanInventaris[]

  @@index([aktif])
}

// Satu kali barang dipegang karyawan. Kembali = `dikembalikanPada` terisi; `kondisiKembali`
// rusak/hilang menambah `InventarisKantor.rusakHilang` sebanyak `jumlah`.
model PeminjamanInventaris {
  id               Int       @id @default(autoincrement())
  inventarisId     Int
  employeeId       Int
  jumlah           Int       @default(1)
  dipinjamPada     DateTime  @default(now())
  dikembalikanPada DateTime?
  // baik | rusak | hilang
  kondisiKembali   String?   @db.VarChar(20)
  catatan          String?   @db.VarChar(255)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  inventaris InventarisKantor @relation(fields: [inventarisId], references: [id], onDelete: Cascade)
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([inventarisId, dikembalikanPada])
  @@index([employeeId])
}

// ── Paritas Hadirr (18 Okt 2026) ────────────────────────────────────────────────────────────
// Tanggal disimpan sebagai DateTime tengah malam LOKAL ("YYYY-MM-DDT00:00:00"), sama dengan
// LeaveRequest — bukan @db.Date, supaya satu konvensi tanggal untuk seluruh modul absensi.

// Pengajuan lembur dari karyawan (hr.overtime). Menit lembur yang DIBAYAR tetap
// Attendance.approvedOvertimeMinutes — itu yang dibaca struk lembur; pengajuan yang disetujui
// menulis ke sana, jadi tidak ada dua sumber untuk satu angka.
model PengajuanLembur {
  id               Int         @id @default(autoincrement())
  employeeId       Int
  tanggal          DateTime
  mulai            String?     @db.VarChar(5)
  selesai          String?     @db.VarChar(5)
  menit            Int
  alasan           String      @db.Text
  status           LeaveStatus @default(pending)
  // "portal" | "link" | "admin"
  sumber           String      @default("portal") @db.VarChar(20)
  menitDisetujui   Int?
  decidedById      Int?
  decidedAt        DateTime?
  catatanKeputusan String?     @db.Text
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  decidedBy User?    @relation("LemburDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([employeeId, tanggal])
  @@index([status])
}

// Jadwal shift PER TANGGAL (hr.schedule). Kalau ada baris untuk (karyawan, tanggal), dia
// MENGALAHKAN Employee.workScheduleId untuk hari itu. libur = true → hari itu libur karyawan
// itu (bukan libur nasional), workScheduleId diabaikan.
model JadwalShift {
  id             Int      @id @default(autoincrement())
  employeeId     Int
  tanggal        DateTime
  workScheduleId Int?
  libur          Boolean  @default(false)
  catatan        String?  @db.VarChar(255)
  createdById    Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workSchedule WorkSchedule? @relation(fields: [workScheduleId], references: [id], onDelete: SetNull)

  @@unique([employeeId, tanggal])
  @@index([tanggal])
}

// Klaim penggantian biaya (hr.reimbursement). status: menunggu | disetujui | ditolak | dibayar.
model Reimbursement {
  id               Int       @id @default(autoincrement())
  employeeId       Int
  tanggal          DateTime
  // transport | makan | bensin | parkir | belanja | lainnya
  kategori         String    @default("lainnya") @db.VarChar(30)
  jumlah           Decimal   @db.Decimal(15, 2)
  keterangan       String    @db.Text
  fotoPath         String?   @db.VarChar(255)
  status           String    @default("menunggu") @db.VarChar(20)
  jumlahDisetujui  Decimal?  @db.Decimal(15, 2)
  sumber           String    @default("portal") @db.VarChar(20)
  decidedById      Int?
  decidedAt        DateTime?
  catatanKeputusan String?   @db.Text
  dibayarAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  decidedBy User?    @relation("ReimburseDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([employeeId, tanggal])
  @@index([status])
}

// Kunjungan ke klien (hr.visits): check-in di lokasi klien (GPS + foto), check-out + hasil.
// Bukan absensi — tidak menyentuh Attendance.
model KunjunganKlien {
  id             Int       @id @default(autoincrement())
  employeeId     Int
  namaKlien      String    @db.VarChar(150)
  alamat         String?   @db.VarChar(255)
  tujuan         String?   @db.VarChar(255)
  masukAt        DateTime
  masukLat       Float
  masukLng       Float
  masukAkurasiM  Int
  masukFoto      String?   @db.VarChar(255)
  keluarAt       DateTime?
  keluarLat      Float?
  keluarLng      Float?
  keluarAkurasiM Int?
  // tertarik | deal | follow_up | tidak_tertarik | lainnya
  hasil          String?   @db.VarChar(30)
  catatan        String?   @db.Text
  ip             String?   @db.VarChar(64)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, masukAt])
  @@index([masukAt])
}

// Catatan pekerjaan per rentang jam (hr.timesheet).
model TimesheetEntri {
  id         Int      @id @default(autoincrement())
  employeeId Int
  tanggal    DateTime
  mulai      String   @db.VarChar(5)
  selesai    String   @db.VarChar(5)
  menit      Int
  proyek     String   @db.VarChar(100)
  kegiatan   String   @db.VarChar(255)
  catatan    String?  @db.Text
  sumber     String   @default("portal") @db.VarChar(20)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, tanggal])
  @@index([proyek])
}

// ── Upah tukang (Tahap 1, 18 Okt 2026) ─────────────────────────────────────────────────────
// Absensi & upah tukang lapangan dihitung di Employee (keputusan Faisal). Bentuknya meniru link
// PIC Qaloka Event: rekap HARIAN per orang (hadir / setengah / absen) + jam lembur + kota, divisi,
// proyek/event. Tanggal = DateTime tengah malam LOKAL, sama dengan LeaveRequest & PengajuanLembur.
// Rekap harian TIDAK menulis ke Attendance (yang itu scan berjam-jam); ia sumber upah tukang.

// Tim tetap. picId = kepala tim (unik: satu PIC satu tim). Anggota = Employee.timId.
model TimKerja {
  id        Int      @id @default(autoincrement())
  nama      String   @unique @db.VarChar(80)
  picId     Int?     @unique
  warna     String   @default("#6366f1") @db.VarChar(9)
  aktif     Boolean  @default(true)
  catatan   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pic     Employee?  @relation("TimPic", fields: [picId], references: [id], onDelete: SetNull)
  anggota Employee[] @relation("TimAnggota")
}

// Matriks tarif Kota × Divisi. Dipakai hanya kalau baris rekap TIDAK punya proyek.
model TarifKotaDivisi {
  id           Int      @id @default(autoincrement())
  kota         String   @db.VarChar(100)
  divisi       String   @db.VarChar(100)
  upahHarian   Decimal  @db.Decimal(12, 2)
  lemburPerJam Decimal  @default(0) @db.Decimal(12, 2)
  aktif        Boolean  @default(true)
  catatan      String?  @db.VarChar(255)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([kota, divisi])
}

// Proyek / event tempat tukang bekerja, dengan tarif khusus opsional. sumber "lokal" = dibuat di
// Employee; Tahap 2 akan mengisi sumber "event" + refId dari instalasi Qaloka Event usaha itu.
model ProyekKerja {
  id           Int       @id @default(autoincrement())
  kode         String?   @db.VarChar(30)
  nama         String    @db.VarChar(150)
  lokasi       String?   @db.VarChar(150)
  mulai        DateTime?
  selesai      DateTime?
  upahHarian   Decimal?  @db.Decimal(12, 2)
  lemburPerJam Decimal?  @db.Decimal(12, 2)
  aktif        Boolean   @default(true)
  sumber       String    @default("lokal") @db.VarChar(20)
  refId        String?   @db.VarChar(64)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  rekap RekapHarian[]

  @@unique([sumber, refId])
  @@index([aktif])
}

// Satu baris = satu orang satu hari. status: hadir | setengah | absen.
// persetujuan: menunggu | disetujui | ditolak — yang dihitung upah HANYA disetujui.
// Kalau PIC mengubah baris yang sudah disetujui, persetujuan kembali "menunggu".
// pembayaranId terisi = sudah dibayar → terkunci (tidak bisa diubah PIC maupun admin).
model RekapHarian {
  id                Int       @id @default(autoincrement())
  employeeId        Int
  tanggal           DateTime
  status            String    @default("absen") @db.VarChar(10)
  lemburJam         Decimal   @default(0) @db.Decimal(5, 2)
  kota              String?   @db.VarChar(100)
  divisi            String?   @db.VarChar(100)
  proyekId          Int?
  catatan           String?   @db.VarChar(255)
  fotoPath          String?   @db.VarChar(255)
  lat               Float?
  lng               Float?
  akurasiM          Int?
  dicatatOlehPicId  Int?
  sumber            String    @default("pic") @db.VarChar(20)
  persetujuan       String    @default("menunggu") @db.VarChar(20)
  decidedById       Int?
  decidedAt         DateTime?
  alasanTolak       String?   @db.Text
  upahKhusus        Decimal?  @db.Decimal(12, 2)
  upahKhususCatatan String?   @db.VarChar(255)
  pembayaranId      Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  employee   Employee        @relation("RekapKaryawan", fields: [employeeId], references: [id], onDelete: Cascade)
  dicatatPic Employee?       @relation("RekapPic", fields: [dicatatOlehPicId], references: [id], onDelete: SetNull)
  proyek     ProyekKerja?    @relation(fields: [proyekId], references: [id], onDelete: SetNull)
  decidedBy  User?           @relation("RekapDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  pembayaran PembayaranUpah? @relation(fields: [pembayaranId], references: [id], onDelete: SetNull)

  @@unique([employeeId, tanggal])
  @@index([tanggal])
  @@index([persetujuan, tanggal])
  @@index([dicatatOlehPicId, tanggal])
}

// bonus | tunjangan (menambah) — potongan | kasbon (mengurangi). jumlah selalu positif.
model PenyesuaianUpah {
  id           Int      @id @default(autoincrement())
  employeeId   Int
  tanggal      DateTime
  jenis        String   @db.VarChar(20)
  jumlah       Decimal  @db.Decimal(12, 2)
  catatan      String?  @db.VarChar(255)
  dibuatOlehId Int?
  pembayaranId Int?
  createdAt    DateTime @default(now())

  employee   Employee        @relation("PenyesuaianKaryawan", fields: [employeeId], references: [id], onDelete: Cascade)
  pembayaran PembayaranUpah? @relation(fields: [pembayaranId], references: [id], onDelete: SetNull)

  @@index([employeeId, tanggal])
}

// Upah yang sudah DIBAYAR untuk satu orang satu periode. rincian = salinan hitungan saat dibayar
// (tarif bisa berubah sesudahnya; slip lama tidak boleh ikut berubah).
model PembayaranUpah {
  id             Int      @id @default(autoincrement())
  employeeId     Int
  periodeMulai   DateTime
  periodeSelesai DateTime
  jumlah         Decimal  @db.Decimal(14, 2)
  rincian        Json
  catatan        String?  @db.VarChar(255)
  dibayarOlehId  Int?
  dibayarAt      DateTime @default(now())
  createdAt      DateTime @default(now())

  employee    Employee          @relation("PembayaranKaryawan", fields: [employeeId], references: [id], onDelete: Cascade)
  rekap       RekapHarian[]
  penyesuaian PenyesuaianUpah[]

  @@index([employeeId, periodeMulai])
}

// Perintah server -> mesin mode CLOUD (protokol realtime Fingerspot). Mesin mengecek perintah tiap
// ~20 detik (receive_cmd); perintah "menunggu" dikirim di cek berikutnya lalu "terkirim", dan mesin
// melapor lewat send_cmd_result (trans_id sama) -> "selesai" / "gagal". 18 Okt 2026: mesin berhenti
// mengirim sendiri data pendaftaran (realtime_enroll_data) sejak 30 Sep, jadi Direktori menarik
// daftar user dengan GET_USER_ID_LIST lalu GET_USER_INFO per PIN yang belum ada.
// HANYA perintah baca yang boleh diantre (lihat PERINTAH_BOLEH di lib/services/fingerspot/perintah.ts).
model FingerspotPerintah {
  id          Int       @id @default(autoincrement())
  machineId   Int
  transId     String    @unique @db.VarChar(40)
  cmdCode     String    @db.VarChar(40)
  body        Json?
  status      String    @default("menunggu") @db.VarChar(20) // menunggu | terkirim | selesai | gagal
  kodeBalasan String?   @db.VarChar(60)
  hasil       Json?
  catatan     String?   @db.VarChar(255)
  dibuatOleh  Int?
  createdAt   DateTime  @default(now())
  dikirimAt   DateTime?
  selesaiAt   DateTime?

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([machineId, status])
  @@index([createdAt])
}

// ── Program magang / PKL (6 Nov 2026) ─────────────────────────────────────────────────────────
// Anak magang = Employee biasa (supaya punya portal /me + PIN), ditandai lewat MagangPeserta.
// Mereka dirotasi antar pos kerja (MagangPenugasan, disusun lib/services/magang/rotasi.ts) dan
// tiap akhir minggu mengisi tugas mengingat + kuis (MagangTugas) yang lalu dinilai pembimbing.

// Pos kerja yang dirotasi (mis. Operator Cetak). durasiMinggu: 2 = pos berat, 1 = pos ringan.
model MagangPos {
  id           Int       @id @default(autoincrement())
  nama         String    @db.VarChar(80)
  // Yang harus dikuasai di pos ini — tampil di HP anak sebagai target minggu ini.
  deskripsi    String?   @db.Text
  durasiMinggu Int       @default(1)
  kapasitas    Int       @default(1)
  urutan       Int       @default(0)
  pembimbingId Int?
  // Tempat pos ini dikerjakan (mis. "Pusat", "Voliko Sport") — label saja, tampil di jadwal & HP anak.
  lokasi       String?   @db.VarChar(80)
  aktif        Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  pembimbing Employee?         @relation("MagangPembimbing", fields: [pembimbingId], references: [id], onDelete: SetNull)
  soal       MagangSoal[]
  penugasan  MagangPenugasan[]
  tugas      MagangTugas[]
  jurnal     MagangJurnal[]

  @@index([pembimbingId])
}

// Bank soal kuis pilihan ganda per pos. pilihan = string[]; benar = indeks pilihan yang benar.
model MagangSoal {
  id         Int      @id @default(autoincrement())
  posId      Int
  pertanyaan String   @db.Text
  pilihan    Json
  benar      Int
  aktif      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pos MagangPos @relation(fields: [posId], references: [id], onDelete: Cascade)

  @@index([posId])
}

model MagangPeserta {
  id             Int       @id @default(autoincrement())
  employeeId     Int       @unique
  sekolah        String?   @db.VarChar(150)
  jurusan        String?   @db.VarChar(100)
  // Guru pembimbing dari sekolah + kontaknya (9 Nov 2026: peserta dari sekolah berbeda).
  guruPembimbing String?   @db.VarChar(150)
  kontakGuru     String?   @db.VarChar(60)
  mulai          DateTime
  selesai        DateTime?
  aktif          Boolean   @default(true)
  catatan        String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  employee  Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  penugasan MagangPenugasan[]
  tugas     MagangTugas[]
  jurnal    MagangJurnal[]
  misi      MagangMisiKiriman[]

  @@index([sekolah])
}

// Satu blok rotasi: anak memegang pos `posId` selama `minggu` minggu mulai Senin `mulai`.
// berbagi = pos itu sedang dipegang anak lain juga (posnya kurang).
model MagangPenugasan {
  id        Int      @id @default(autoincrement())
  pesertaId Int
  posId     Int
  mulai     DateTime
  minggu    Int
  berbagi   Boolean  @default(false)
  createdAt DateTime @default(now())

  peserta MagangPeserta @relation(fields: [pesertaId], references: [id], onDelete: Cascade)
  pos     MagangPos     @relation(fields: [posId], references: [id], onDelete: Cascade)

  @@index([pesertaId, mulai])
  @@index([posId])
}

// Tugas mengingat mingguan. senin = Senin minggu yang dinilai. jawabanKuis = salinan soal yang
// dikerjakan + jawabannya (riwayat tidak berubah bila bank soal disunting). Kolom nilai praktik
// (1–4) = ASPEK_PRAKTIK di lib/services/magang/nilai.ts.
model MagangTugas {
  id                    Int       @id @default(autoincrement())
  pesertaId             Int
  senin                 DateTime
  posId                 Int?
  ingatan               String    @db.Text
  jawabanKuis           Json
  skorKuis              Int?
  terlambat             Boolean   @default(false)
  dikirimAt             DateTime  @default(now())
  nilaiIngatan          Int?
  ketelitian            Int?
  kecepatan             Int?
  inisiatif             Int?
  sikap                 Int?
  nilai                 Int?
  catatanPembimbing     String?   @db.Text
  dinilaiOlehId         Int?
  // Dinilai pembimbing dari halaman pribadinya (/me/<token>, 8 Nov 2026) — bukan akun dashboard.
  dinilaiOlehKaryawanId Int?
  dinilaiAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  peserta             MagangPeserta @relation(fields: [pesertaId], references: [id], onDelete: Cascade)
  pos                 MagangPos?    @relation(fields: [posId], references: [id], onDelete: SetNull)
  dinilaiOleh         User?         @relation("MagangPenilai", fields: [dinilaiOlehId], references: [id], onDelete: SetNull)
  dinilaiOlehKaryawan Employee?     @relation("MagangPenilaiKaryawan", fields: [dinilaiOlehKaryawanId], references: [id], onDelete: SetNull)

  @@unique([pesertaId, senin])
  @@index([posId])
  @@index([dinilaiAt])
  @@index([dinilaiOlehKaryawanId])
}

// Jurnal harian anak magang (7 Nov 2026): apa yang dikerjakan hari itu + foto (maks 3, path di
// storage/magang) + kendala. Satu baris per anak per tanggal; anak boleh menyunting sampai dicek
// pembimbing. Rapor hanya memakai kelengkapannya (kerajinan), bukan nilainya.
model MagangJurnal {
  id                  Int       @id @default(autoincrement())
  pesertaId           Int
  tanggal             DateTime
  posId               Int?
  kegiatan            String    @db.Text
  kendala             String?   @db.Text
  foto                Json
  komentar            String?   @db.Text
  dicekAt             DateTime?
  dicekOlehId         Int?
  // Dicek pembimbing dari halaman pribadinya (/me/<token>, 8 Nov 2026) — bukan akun dashboard.
  dicekOlehKaryawanId Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  peserta           MagangPeserta @relation(fields: [pesertaId], references: [id], onDelete: Cascade)
  pos               MagangPos?    @relation(fields: [posId], references: [id], onDelete: SetNull)
  dicekOleh         User?         @relation("MagangJurnalCek", fields: [dicekOlehId], references: [id], onDelete: SetNull)
  dicekOlehKaryawan Employee?     @relation("MagangJurnalCekKaryawan", fields: [dicekOlehKaryawanId], references: [id], onDelete: SetNull)

  @@unique([pesertaId, tanggal])
  @@index([dicekAt])
  @@index([dicekOlehKaryawanId])
}

// Tautan pendaftaran mandiri. Anak yang mendaftar masuk MagangPendaftar (BUKAN Employee) sampai
// disetujui pengawas — tidak memakan kuota karyawan, tidak muncul di Direktori/absensi.
model MagangDaftar {
  id            Int       @id @default(autoincrement())
  kode          String    @unique @db.VarChar(36)
  label         String    @db.VarChar(100)
  berlakuSampai DateTime
  mulaiMagang   DateTime?
  selesaiMagang DateTime?
  // Tautan khusus satu sekolah/rombongan: diisi → kolom sekolah di formulir sudah terisi & dikunci.
  sekolah       String?   @db.VarChar(150)
  aktif         Boolean   @default(true)
  createdAt     DateTime  @default(now())

  pendaftar MagangPendaftar[]
}

// token = publicToken karyawan nanti (tautan HP yang dipegang anak tidak berubah sesudah
// disetujui). pinHash = PIN portal yang dibuat anak saat mendaftar (bcrypt).
model MagangPendaftar {
  id             Int       @id @default(autoincrement())
  daftarId       Int
  token          String    @unique @db.VarChar(36)
  namaLengkap    String    @db.VarChar(150)
  panggilan      String?   @db.VarChar(50)
  hp             String?   @db.VarChar(30)
  sekolah        String?   @db.VarChar(150)
  jurusan        String?   @db.VarChar(100)
  guruPembimbing String?   @db.VarChar(150)
  kontakGuru     String?   @db.VarChar(60)
  mulai          DateTime
  selesai        DateTime?
  pinHash        String    @db.VarChar(100)
  status         String    @default("menunggu") @db.VarChar(20) // menunggu | disetujui | ditolak
  alasanTolak    String?   @db.VarChar(255)
  employeeId     Int?
  diputusAt      DateTime?
  createdAt      DateTime  @default(now())

  daftar MagangDaftar @relation(fields: [daftarId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ── Side quest magang (9 Nov 2026) ─────────────────────────────────────────────────────────────
// Misi WAJIB di luar rotasi pos (Customer Service, Desain Grafis, Digital Marketing) yang dikerjakan
// sepanjang magang. Berlaku untuk SEMUA peserta (tanpa baris penugasan): misi aktif = tugas tiap anak.
// kategori = KATEGORI_MISI di lib/services/magang/misi.ts; bukti = daftar "foto,tautan,teks".
model MagangMisi {
  id        Int       @id @default(autoincrement())
  kategori  String    @db.VarChar(20)
  level     String    @default("dasar") @db.VarChar(20)
  judul     String    @db.VarChar(150)
  deskripsi String?   @db.Text
  bukti     String    @default("foto") @db.VarChar(30)
  poin      Int       @default(10)
  urutan    Int       @default(0)
  aktif     Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kiriman MagangMisiKiriman[]

  @@index([kategori])
}

// Bukti misi dari anak. Satu baris per anak per misi: ditolak → anak memperbaiki & mengirim ulang
// (baris yang sama kembali "menunggu"); disetujui → terkunci. foto = path di storage/magang.
model MagangMisiKiriman {
  id                    Int       @id @default(autoincrement())
  misiId                Int
  pesertaId             Int
  teks                  String?   @db.Text
  tautan                String?   @db.VarChar(500)
  foto                  Json
  status                String    @default("menunggu") @db.VarChar(20) // menunggu | disetujui | ditolak
  catatan               String?   @db.Text
  kirimKe               Int       @default(1)
  dikirimAt             DateTime  @default(now())
  diputusAt             DateTime?
  diputusOlehId         Int?
  diputusOlehKaryawanId Int?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  misi                MagangMisi    @relation(fields: [misiId], references: [id], onDelete: Cascade)
  peserta             MagangPeserta @relation(fields: [pesertaId], references: [id], onDelete: Cascade)
  diputusOleh         User?         @relation("MagangMisiPutus", fields: [diputusOlehId], references: [id], onDelete: SetNull)
  diputusOlehKaryawan Employee?     @relation("MagangMisiPutusKaryawan", fields: [diputusOlehKaryawanId], references: [id], onDelete: SetNull)

  @@unique([misiId, pesertaId])
  @@index([pesertaId])
  @@index([status])
  @@index([diputusOlehId])
  @@index([diputusOlehKaryawanId])
}
